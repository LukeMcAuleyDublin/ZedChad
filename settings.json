{
  "show_edit_predictions": false,
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "icon_theme": "Warm Charmed Icons",
  "theme": "Catppuccin Latte",
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18,
  "buffer_font_weight": 500,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 16,
  "ui_font_weight": 400,
  "vim_mode": true,
  "relative_line_numbers": true,
  "cursor_blink": false,
  "scrollbar": {
    "show": "never"
  },
  "buffer_line_height": {
    "custom": 1.7
  },
  "terminal": {
    "dock": "right",
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 16,
    "line_height": {
      "custom": 1.3
    }
  },
  "languages": {
    "Ruby": {
      "language_servers": ["solargraph"]
    },
    "YAML": { "format_on_save": "off" }
  }
}
